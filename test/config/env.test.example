# Test Environment Configuration Template
# Copy this to .env.test in the root directory and update with your values

# Test Database Configuration
DB_HOST=localhost
DB_NAME=streamscene_test
DB_USER=root
DB_PASS=

# Disable external services in tests
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=test-bucket

# Session Configuration
SESSION_SECRET=test-session-secret-key

# OAuth (not used in tests, but required)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# AI Features (disabled in tests)
GEMINI_API_KEY=

# Feature Flags
USE_MOCK_X_API=true

# Server Configuration
PORT=8001
NODE_ENV=test

